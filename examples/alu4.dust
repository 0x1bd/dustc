// this uses the built-in ALU.

module main(
    #[panel]
    input operands {
        a: bits<4>,
        b: bits<4>,
    },
    #[panel]
    input control {
        operation: bits<3>,
    },
    #[panel]
    output result {
        value: bits<4>,
        zero: bit,
        negative: bit,
        carry: bit,
        overflow: bit,
    },
) {
    let calculated = alu(a, b, operation)
    value = calculated.value
    zero = calculated.zero
    negative = calculated.negative
    carry = calculated.carry
    overflow = calculated.overflow
}
