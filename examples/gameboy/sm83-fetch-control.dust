module sm83_instruction_decode(
    input instruction: bits<8>,
    output source: bits<3>,
    output destination: bits<3>,
    output alu_operation: bits<3>,
    output block_zero: bit,
    output load8: bit,
    output load_immediate8: bit,
    output load_immediate16: bit,
    output alu8: bit,
    output alu_immediate8: bit,
    output inc8: bit,
    output dec8: bit,
    output inc16: bit,
    output dec16: bit,
    output add_hl16: bit,
    output jump_relative: bit,
    output jump_relative_conditional: bit,
    output jump_absolute: bit,
    output jump_absolute_conditional: bit,
    output jump_hl: bit,
    output push: bit,
    output pop: bit,
    output call: bit,
    output call_conditional: bit,
    output ret: bit,
    output ret_conditional: bit,
    output reti: bit,
    output rst: bit,
    output load_a_indirect: bit,
    output store_a_indirect: bit,
    output load_high_immediate: bit,
    output store_high_immediate: bit,
    output load_high_c: bit,
    output store_high_c: bit,
    output load_a_absolute: bit,
    output store_a_absolute: bit,
    output store_sp_absolute: bit,
    output nop: bit,
    output stop: bit,
    output rotate_a: bit,
    output daa: bit,
    output cpl: bit,
    output scf: bit,
    output ccf: bit,
    output add_sp_offset: bit,
    output load_hl_sp_offset: bit,
    output load_sp_hl: bit,
    output di: bit,
    output ei: bit,
    output prefix_cb: bit,
    output block_three: bit,
    output halt: bit,
) {
    let zero = (~instruction[7]) & (~instruction[6])
    let load = (~instruction[7]) & instruction[6]
    let arithmetic = instruction[7] & (~instruction[6])
    let three = instruction[7] & instruction[6]
    let increment = zero & instruction[2] & (~instruction[1]) & (~instruction[0])
    let decrement = zero & instruction[2] & (~instruction[1]) & instruction[0]
    let immediate = instruction[2] & instruction[1] & (~instruction[0])
    let immediate16 = zero & (~instruction[3]) & (~instruction[2]) & (~instruction[1]) & instruction[0]
    let increment16 = zero & (~instruction[3]) & (~instruction[2]) & instruction[1] & instruction[0]
    let decrement16 = zero & instruction[3] & (~instruction[2]) & instruction[1] & instruction[0]
    let add_hl = zero & instruction[3] & (~instruction[2]) & (~instruction[1]) & instruction[0]
    let relative_jump = zero & (~instruction[5]) & instruction[4] & instruction[3] &
        (~instruction[2]) & (~instruction[1]) & (~instruction[0])
    let relative_conditional = zero & instruction[5] & (~instruction[2]) & (~instruction[1]) & (~instruction[0])
    let absolute_jump = three & (~instruction[5]) & (~instruction[4]) & (~instruction[3]) &
        (~instruction[2]) & instruction[1] & instruction[0]
    let absolute_conditional = three & (~instruction[5]) & (~instruction[2]) & instruction[1] & (~instruction[0])
    let hl_jump = instruction[7] & instruction[6] & instruction[5] & (~instruction[4]) & instruction[3] &
        (~instruction[2]) & (~instruction[1]) & instruction[0]
    let stack_push = three & (~instruction[3]) & instruction[2] & (~instruction[1]) & instruction[0]
    let stack_pop = three & (~instruction[3]) & (~instruction[2]) & (~instruction[1]) & instruction[0]
    let subroutine_call = three & (~instruction[5]) & (~instruction[4]) & instruction[3] & instruction[2] &
        (~instruction[1]) & instruction[0]
    let conditional_call = three & (~instruction[5]) & instruction[2] & (~instruction[1]) & (~instruction[0])
    let subroutine_return = three & (~instruction[5]) & (~instruction[4]) & instruction[3] &
        (~instruction[2]) & (~instruction[1]) & instruction[0]
    let conditional_return = three & (~instruction[5]) & (~instruction[2]) & (~instruction[1]) &
        (~instruction[0])
    let interrupt_return = three & (~instruction[5]) & instruction[4] & instruction[3] &
        (~instruction[2]) & (~instruction[1]) & instruction[0]
    let restart = three & instruction[2] & instruction[1] & instruction[0]
    let indirect_load = zero & instruction[3] & (~instruction[2]) & instruction[1] & (~instruction[0])
    let indirect_store = zero & (~instruction[3]) & (~instruction[2]) & instruction[1] & (~instruction[0])
    let high_immediate = three & instruction[5] & (~instruction[3]) & (~instruction[2]) &
        (~instruction[1]) & (~instruction[0])
    let high_c = three & instruction[5] & (~instruction[3]) & (~instruction[2]) &
        instruction[1] & (~instruction[0])
    let absolute_a = three & instruction[5] & instruction[3] & (~instruction[2]) &
        instruction[1] & (~instruction[0])
    let absolute_sp = zero & (~instruction[5]) & (~instruction[4]) & instruction[3] &
        (~instruction[2]) & (~instruction[1]) & (~instruction[0])
    let no_operation = zero & (~instruction[5]) & (~instruction[4]) & (~instruction[3]) &
        (~instruction[2]) & (~instruction[1]) & (~instruction[0])
    let stopped = zero & (~instruction[5]) & instruction[4] & (~instruction[3]) &
        (~instruction[2]) & (~instruction[1]) & (~instruction[0])
    let accumulator_rotate = zero & (~instruction[5]) & instruction[2] & instruction[1] & instruction[0]
    let accumulator_misc = zero & instruction[5] & instruction[2] & instruction[1] & instruction[0]
    let sp_offset = three & instruction[5] & instruction[3] & (~instruction[2]) &
        (~instruction[1]) & (~instruction[0])
    let sp_from_hl = three & instruction[5] & instruction[4] & instruction[3] &
        (~instruction[2]) & (~instruction[1]) & instruction[0]
    let interrupt_control = three & instruction[5] & instruction[4] & (~instruction[2]) &
        instruction[1] & instruction[0]
    let cb_prefix = three & (~instruction[5]) & (~instruction[4]) & instruction[3] &
        (~instruction[2]) & instruction[1] & instruction[0]
    let source_is_six = instruction[2] & instruction[1] & (~instruction[0])
    let destination_is_six = instruction[5] & instruction[4] & (~instruction[3])
    let is_halt = load & source_is_six & destination_is_six

    source = instruction[0..3]
    destination = instruction[3..6]
    alu_operation = instruction[3..6]
    block_zero = zero
    load8 = load & (~is_halt)
    load_immediate8 = zero & immediate
    load_immediate16 = immediate16
    alu8 = arithmetic
    alu_immediate8 = three & immediate
    inc8 = increment
    dec8 = decrement
    inc16 = increment16
    dec16 = decrement16
    add_hl16 = add_hl
    jump_relative = relative_jump
    jump_relative_conditional = relative_conditional
    jump_absolute = absolute_jump
    jump_absolute_conditional = absolute_conditional
    jump_hl = hl_jump
    push = stack_push
    pop = stack_pop
    call = subroutine_call
    call_conditional = conditional_call
    ret = subroutine_return
    ret_conditional = conditional_return
    reti = interrupt_return
    rst = restart
    load_a_indirect = indirect_load
    store_a_indirect = indirect_store
    load_high_immediate = high_immediate & instruction[4]
    store_high_immediate = high_immediate & (~instruction[4])
    load_high_c = high_c & instruction[4]
    store_high_c = high_c & (~instruction[4])
    load_a_absolute = absolute_a & instruction[4]
    store_a_absolute = absolute_a & (~instruction[4])
    store_sp_absolute = absolute_sp
    nop = no_operation
    stop = stopped
    rotate_a = accumulator_rotate
    daa = accumulator_misc & (~instruction[4]) & (~instruction[3])
    cpl = accumulator_misc & (~instruction[4]) & instruction[3]
    scf = accumulator_misc & instruction[4] & (~instruction[3])
    ccf = accumulator_misc & instruction[4] & instruction[3]
    add_sp_offset = sp_offset & (~instruction[4])
    load_hl_sp_offset = sp_offset & instruction[4]
    load_sp_hl = sp_from_hl
    di = interrupt_control & (~instruction[3])
    ei = interrupt_control & instruction[3]
    prefix_cb = cb_prefix
    block_three = three
    halt = is_halt
}

module sm83_fetch_control(
    input memory_ready: bit,
    input execute_ready: bit,
    input execute_memory_read: bit,
    input halt_request: bit,
    input wake: bit,
    input reset: bit,
    input clock: bit,
    output memory_read: bit,
    output instruction_load: bit,
    output pc_increment: bit,
    output fetch: bit,
    output execute: bit,
    output commit: bit,
    output halted: bit,
) {
    let rec phase = resettable_register<2>(
        if phase[1] {
            if wake { const_bits<2>(0) } else { const_bits<2>(2) }
        } else {
            if phase[0] {
                if execute_ready {
                    if halt_request { const_bits<2>(2) } else { const_bits<2>(0) }
                } else {
                    const_bits<2>(1)
                }
            } else {
                if memory_ready { const_bits<2>(1) } else { const_bits<2>(0) }
            }
        },
        reset,
        clock,
    )
    let fetching = (~phase[1]) & (~phase[0])
    let executing = (~phase[1]) & phase[0]
    let stopped = phase[1]
    let accepted = fetching & memory_ready

    memory_read = fetching | (executing & execute_memory_read)
    instruction_load = accepted
    pc_increment = accepted
    fetch = fetching
    execute = executing
    commit = executing & execute_ready
    halted = stopped
}

module sm83_fetch_control_demo(
    #[panel]
    input control {
        instruction: bits<8>,
        memory_ready: bit,
        execute_ready: bit,
        execute_memory_read: bit,
        halt_request: bit,
        wake: bit,
        reset: bit,
        clock: bit,
    },
    #[panel]
    output phase {
        memory_read: bit,
        instruction_load: bit,
        pc_increment: bit,
        fetch: bit,
        execute: bit,
        commit: bit,
        halted: bit,
    },
    #[panel]
    output decode {
        source: bits<3>,
        destination: bits<3>,
        alu_operation: bits<3>,
        block_zero: bit,
        load8: bit,
        load_immediate8: bit,
        load_immediate16: bit,
        alu8: bit,
        alu_immediate8: bit,
        inc8: bit,
        dec8: bit,
        inc16: bit,
        dec16: bit,
        add_hl16: bit,
        jump_relative: bit,
        jump_relative_conditional: bit,
        jump_absolute: bit,
        jump_absolute_conditional: bit,
        jump_hl: bit,
        push: bit,
        pop: bit,
        call: bit,
        call_conditional: bit,
        ret: bit,
        ret_conditional: bit,
        reti: bit,
        rst: bit,
        load_a_indirect: bit,
        store_a_indirect: bit,
        load_high_immediate: bit,
        store_high_immediate: bit,
        load_high_c: bit,
        store_high_c: bit,
        load_a_absolute: bit,
        store_a_absolute: bit,
        store_sp_absolute: bit,
        nop: bit,
        stop: bit,
        rotate_a: bit,
        daa: bit,
        cpl: bit,
        scf: bit,
        ccf: bit,
        add_sp_offset: bit,
        load_hl_sp_offset: bit,
        load_sp_hl: bit,
        di: bit,
        ei: bit,
        prefix_cb: bit,
        block_three: bit,
        halt: bit,
    },
) {
    let sequencer = sm83_fetch_control(
        memory_ready,
        execute_ready,
        execute_memory_read,
        halt_request,
        wake,
        reset,
        clock,
    )
    let decoded = sm83_instruction_decode(instruction)
    memory_read = sequencer.memory_read
    instruction_load = sequencer.instruction_load
    pc_increment = sequencer.pc_increment
    fetch = sequencer.fetch
    execute = sequencer.execute
    commit = sequencer.commit
    halted = sequencer.halted
    source = decoded.source
    destination = decoded.destination
    alu_operation = decoded.alu_operation
    block_zero = decoded.block_zero
    load8 = decoded.load8
    load_immediate8 = decoded.load_immediate8
    load_immediate16 = decoded.load_immediate16
    alu8 = decoded.alu8
    alu_immediate8 = decoded.alu_immediate8
    inc8 = decoded.inc8
    dec8 = decoded.dec8
    inc16 = decoded.inc16
    dec16 = decoded.dec16
    add_hl16 = decoded.add_hl16
    jump_relative = decoded.jump_relative
    jump_relative_conditional = decoded.jump_relative_conditional
    jump_absolute = decoded.jump_absolute
    jump_absolute_conditional = decoded.jump_absolute_conditional
    jump_hl = decoded.jump_hl
    push = decoded.push
    pop = decoded.pop
    call = decoded.call
    call_conditional = decoded.call_conditional
    ret = decoded.ret
    ret_conditional = decoded.ret_conditional
    reti = decoded.reti
    rst = decoded.rst
    load_a_indirect = decoded.load_a_indirect
    store_a_indirect = decoded.store_a_indirect
    load_high_immediate = decoded.load_high_immediate
    store_high_immediate = decoded.store_high_immediate
    load_high_c = decoded.load_high_c
    store_high_c = decoded.store_high_c
    load_a_absolute = decoded.load_a_absolute
    store_a_absolute = decoded.store_a_absolute
    store_sp_absolute = decoded.store_sp_absolute
    nop = decoded.nop
    stop = decoded.stop
    rotate_a = decoded.rotate_a
    daa = decoded.daa
    cpl = decoded.cpl
    scf = decoded.scf
    ccf = decoded.ccf
    add_sp_offset = decoded.add_sp_offset
    load_hl_sp_offset = decoded.load_hl_sp_offset
    load_sp_hl = decoded.load_sp_hl
    di = decoded.di
    ei = decoded.ei
    prefix_cb = decoded.prefix_cb
    block_three = decoded.block_three
    halt = decoded.halt
}
