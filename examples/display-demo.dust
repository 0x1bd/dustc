module main(
    #[panel]
    #[edge(north)]
    input controls {
        write: bit,
        clear: bit,
        clock: bit,
    },
    #[panel]
    #[edge(north)]
    output status {
        position: bits<3>,
    },
) {
    let rec coordinate = register<3>(
        if clear { const_bits<3>(0) } else {
            if write { increment<3>(coordinate).result } else { coordinate }
        },
        clock,
    )

    display<8, 8>(coordinate, coordinate, true, write, clear, clock)
    position = coordinate
}
