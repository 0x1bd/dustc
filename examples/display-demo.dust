module main(
    #[panel]
    #[edge(south)]
    input controls {
        x: bits<3>,
        y: bits<3>,
        pixel_value: bit,
        plot: bit,
        plot_all: bit,
    },
    #[panel]
    #[edge(south)]
    output status {
        ready: bit,
    },
    output screen: display<8, 8>,
) {
    screen = display_write(x, y, pixel_value, plot, plot_all)
    ready = true
}
