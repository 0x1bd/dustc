{
  "Module": {
    "prefix": "module",
    "description": "Declare a module with one input and one output group",
    "body": [
      "module ${1:main}(",
      "\tinput ${2:operands} {",
      "\t\t${3:a}: ${4|bit,bits<4>,bits<8>|},",
      "\t},",
      "\toutput ${5:result} {",
      "\t\t${6:y}: ${7|bit,bits<4>,bits<8>|},",
      "\t},",
      ") {",
      "\t$0",
      "}"
    ]
  },
  "For loop": {
    "prefix": "for",
    "description": "Unrolled elaboration loop",
    "body": ["for ${1:i} in ${2:0}..${3:8} {", "\t$0", "}"]
  },
  "Parameterized module": {
    "prefix": "moduleconst",
    "description": "Declare a module with a compile-time integer parameter",
    "body": [
      "module ${1:main}<const ${2:WIDTH}: int = ${3:8}>(",
      "\tinput ${4:a}: bits<${2:WIDTH}>,",
      "\toutput ${5:y}: bits<${2:WIDTH}>,",
      ") {",
      "\t$0",
      "}"
    ]
  },
  "Hardware if expression": {
    "prefix": "if",
    "description": "Select between two hardware values",
    "body": ["if ${1:condition} { ${2:when_true} } else { ${3:when_false} }"]
  },
  "Let binding": {
    "prefix": "let",
    "description": "Name a signal expression",
    "body": ["let ${1:name} = $0"]
  },
  "Mutable let binding": {
    "prefix": "letmut",
    "description": "Rebindable elaboration value",
    "body": ["let mut ${1:carry} = ${2:cin}"]
  },
  "Recursive register binding": {
    "prefix": "letrec",
    "description": "Declare registered state with legal next-state feedback",
    "body": ["let rec ${1:state} = resettable_register<${2:8}>(${3:next_state}, ${4:reset}, ${5:clock})"]
  },
  "Multiplexer": {
    "prefix": "mux",
    "description": "Equal-width multiplexer",
    "body": ["mux(${1:select}, ${2:low}, ${3:high})"]
  },
  "Latch": {
    "prefix": "latch",
    "description": "One-bit latch; high hold keeps the old value",
    "body": ["latch(${1:data}, ${2:hold})"]
  },
  "D flip-flop": {
    "prefix": "dff",
    "description": "Store one bit when the clock changes from 0 to 1",
    "body": ["dff(${1:data}, ${2:clock})"]
  },
  "Register": {
    "prefix": "register",
    "description": "Store a bus when the clock changes from 0 to 1",
    "body": ["register(${1:data}, ${2:clock})"]
  },
  "Generated clock": {
    "prefix": "clock",
    "description": "Generate a repeating clock with a period measured in redstone ticks",
    "body": ["clock<${1:10}>(${2:enabled})"]
  },
  "Display output": {
    "prefix": "displayout",
    "description": "Declare and drive a persistent physical display output",
    "body": [
      "output ${1:screen}: display<${2:8}, ${3:8}>,",
      "$0",
      "${1:screen} = display_write(${4:x}, ${5:y}, ${6:pixel_value}, ${7:plot}, ${8:plot_all})"
    ]
  },
  "Enabled register": {
    "prefix": "enabled_register",
    "description": "Capture a bus when enable is high",
    "body": ["enabled_register(${1:data}, ${2:enable}, ${3:clock})"]
  },
  "Resettable register": {
    "prefix": "resettable_register",
    "description": "Synchronously reset or capture a bus",
    "body": ["resettable_register(${1:data}, ${2:reset}, ${3:clock})"]
  },
  "Placement tier": {
    "prefix": "tier",
    "description": "Place a signal on a physical tier",
    "body": ["#[tier(${1:0})]", "let ${2:name} = $0"]
  },
  "Placement near": {
    "prefix": "near",
    "description": "Place a signal near named placement targets",
    "body": ["#[near(${1:target})]", "let ${2:name} = $0"]
  },
  "I/O edge": {
    "prefix": "edge",
    "description": "Constrain a top-level I/O port or group edge",
    "body": ["#[edge(${1|north,south,east,west|})]"]
  },
  "I/O panel": {
    "prefix": "panel",
    "description": "Lay out a named top-level I/O group as a compact panel",
    "body": ["#[panel]"]
  }
}
