{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dust",
  "scopeName": "source.dust",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#module" },
    { "include": "#port" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#call" },
    { "include": "#member" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dust",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.dust" }
          }
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.dust",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.dust" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.dust" }
      },
      "patterns": [{ "include": "#block-comment" }]
    },
    "attributes": {
      "begin": "(#)(\\[)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.annotation.dust" },
        "2": { "name": "punctuation.section.brackets.begin.dust" },
        "3": { "name": "entity.other.attribute-name.dust" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.dust" }
      },
      "patterns": [
        {
          "name": "constant.language.direction.dust",
          "match": "\\b(north|south|east|west)\\b"
        },
        { "include": "#numbers" },
        {
          "name": "variable.parameter.attribute.dust",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        { "include": "#punctuation" }
      ]
    },
    "module": {
      "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.module.dust" },
        "2": { "name": "entity.name.function.module.dust" }
      }
    },
    "port": {
      "match": "\\b(input|output)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.port.dust" },
        "2": { "name": "variable.other.declaration.dust" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.loop.dust",
          "match": "\\b(for|in)\\b"
        },
        {
          "name": "keyword.control.conditional.dust",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.declaration.dust",
          "match": "\\b(module|input|output|const)\\b"
        },
        {
          "name": "storage.modifier.dust",
          "match": "\\b(rec|mut|const)\\b"
        },
        {
          "name": "keyword.other.let.dust",
          "match": "\\blet\\b"
        },
        {
          "name": "keyword.operator.word.dust",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "constant.language.boolean.dust",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.dust",
      "match": "\\b(bits|bit|int)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.dust",
      "match": "\\b(mux|latch|dff|register|enabled_register|resettable_register|clog2|const_bits)\\b(?=\\s*(?:<[^>]*>)?\\s*\\()"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.dust",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.dust",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.decimal.dust",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "call": {
      "match": "\\b(?!(?:module|input|output|let|rec|mut|for|in|if|else|and|or|bit|bits|mux|latch|dff|register|enabled_register|resettable_register)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.dust" }
      }
    },
    "member": {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.accessor.dust" },
        "2": { "name": "variable.other.member.dust" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.dust",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.logical.dust",
          "match": "[&|^~!]"
        },
        {
          "name": "keyword.operator.arithmetic.dust",
          "match": "[+*/%-]"
        },
        {
          "name": "keyword.operator.assignment.dust",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.typeparameters.dust",
          "match": "[<>]"
        },
        {
          "name": "punctuation.section.block.dust",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.dust",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.dust",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.dust",
          "match": "[,:]"
        }
      ]
    }
  }
}
